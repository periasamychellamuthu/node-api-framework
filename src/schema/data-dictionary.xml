<?xml version="1.0" encoding="UTF-8"?>
<!--
  Product Layer Data Dictionary — Versatile Platform
  Architecture reference: architecture-knowledge-base.md §7, §8, §9

  IMPORTANT DESIGN RULES:
  ─────────────────────────────────────────────────────────────────────────────
  1. NO org_id column on any table here.
     Org isolation is enforced by the framework's automatic range injection:
       WHERE pk_id BETWEEN req.rangeStart AND req.rangeEnd
     This is the Node.js equivalent of SDP's dataspace injection pattern.

  2. All PKs (member_id, role_id, module_id, field_id, record_id, value_id)
     are org-scoped sequence values — generated by SequenceGenerator.getNextId(orgId).
     They are globally unique because each org's range is non-overlapping.

  3. permissions table is the ONLY exception — its PK is global AUTO_INCREMENT
     because permissions are system-wide (not per-org). It has no PK declared
     in this DD; SchemaBuilder produces the AUTO_INCREMENT DDL directly.

  4. Framework-owned tables (iam_auth_accounts, iam_account_profiles,
     token_blacklist, id_range_allocator, org_id_ranges, organizations)
     are NOT in this file. SchemaBuilder.syncFrameworkTables() creates them.
  ─────────────────────────────────────────────────────────────────────────────
-->
<data-dictionary name="product">

  <!-- ════════════════════════════════════════════════════════════════════════
       RBAC — Roles, Permissions, Assignments
       ════════════════════════════════════════════════════════════════════════ -->

  <table name="roles">
    <description>Role definitions — org-scoped by range. System roles (is_system_role=1) cannot be deleted.</description>
    <columns>
      <column name="role_id">
        <description>Org-scoped sequence PK (globally unique via range allocation)</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
        <uniquevalue-generation>
          <generator-name>roles.role_id</generator-name>
        </uniquevalue-generation>
      </column>
      <column name="name">
        <description>Role name e.g. OrgAdmin, ModuleConfig, Member</description>
        <data-type>VARCHAR</data-type>
        <max-size>100</max-size>
        <nullable>false</nullable>
      </column>
      <column name="is_system_role">
        <description>1 = seeded by system at org creation, cannot be deleted by org admin</description>
        <data-type>BOOLEAN</data-type>
        <max-size>1</max-size>
        <nullable>false</nullable>
      </column>
      <column name="description">
        <description>Human-readable role description</description>
        <data-type>VARCHAR</data-type>
        <max-size>500</max-size>
        <nullable>true</nullable>
      </column>
    </columns>
    <primary-key name="roles_PK">
      <primary-key-column>role_id</primary-key-column>
    </primary-key>
  </table>

  <table name="permissions">
    <description>
      System-wide permission registry — NOT org-scoped.
      PK is global AUTO_INCREMENT managed by MySQL (not SequenceGenerator).
      Stores (resource, action) pairs seeded when custom modules are created.
    </description>
    <columns>
      <column name="permission_id">
        <description>Global auto-increment PK</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="resource">
        <description>Resource name e.g. it_procurement, custom_module_handle</description>
        <data-type>VARCHAR</data-type>
        <max-size>100</max-size>
        <nullable>false</nullable>
      </column>
      <column name="action">
        <description>Action: create | read | update | delete | configure</description>
        <data-type>VARCHAR</data-type>
        <max-size>50</max-size>
        <nullable>false</nullable>
      </column>
    </columns>
    <primary-key name="permissions_PK">
      <primary-key-column>permission_id</primary-key-column>
    </primary-key>
  </table>

  <table name="role_permissions">
    <description>Role-to-permission mapping. Composite PK (role_id, permission_id).</description>
    <columns>
      <column name="role_id">
        <description>FK to roles.role_id (org-scoped)</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="permission_id">
        <description>FK to permissions.permission_id (global)</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
    </columns>
    <primary-key name="role_permissions_PK">
      <primary-key-column>role_id, permission_id</primary-key-column>
    </primary-key>
    <!--
      NOTE: Both FKs are application-enforced only.
      role_id is range-scoped (same org); permission_id is global (cross-range DB FK not possible).
    -->
    <foreign-keys>
      <foreign-key name="role_permissions_roles_FK">
        <fk-column>role_id</fk-column>
        <ref-table>roles</ref-table>
        <ref-column>role_id</ref-column>
      </foreign-key>
      <foreign-key name="role_permissions_permissions_FK">
        <fk-column>permission_id</fk-column>
        <ref-table>permissions</ref-table>
        <ref-column>permission_id</ref-column>
      </foreign-key>
    </foreign-keys>
  </table>

  <table name="user_roles">
    <description>
      Member-to-role assignment. Org-scoped by range on member_id.
      Same IAM account can have different roles in different orgs (different member_id ranges).
      granted_by is a member_id audit trail of who assigned the role.
    </description>
    <columns>
      <column name="member_id">
        <description>FK to org_members.member_id (org-scoped)</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="role_id">
        <description>FK to roles.role_id (org-scoped)</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="granted_at">
        <description>When the role was assigned</description>
        <data-type>DATETIME</data-type>
        <nullable>false</nullable>
      </column>
      <column name="granted_by">
        <description>member_id of the org admin who assigned the role (audit)</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>true</nullable>
      </column>
    </columns>
    <primary-key name="user_roles_PK">
      <primary-key-column>member_id, role_id</primary-key-column>
    </primary-key>
    <!--
      NOTE: All FKs are application-enforced only — member_id and role_id are range-scoped PKs;
      no DB-level FK across range-isolated tables. granted_by is a self-referential audit link.
    -->
    <foreign-keys>
      <foreign-key name="user_roles_org_members_FK">
        <fk-column>member_id</fk-column>
        <ref-table>org_members</ref-table>
        <ref-column>member_id</ref-column>
      </foreign-key>
      <foreign-key name="user_roles_roles_FK">
        <fk-column>role_id</fk-column>
        <ref-table>roles</ref-table>
        <ref-column>role_id</ref-column>
      </foreign-key>
      <foreign-key name="user_roles_granted_by_FK">
        <fk-column>granted_by</fk-column>
        <ref-table>org_members</ref-table>
        <ref-column>member_id</ref-column>
      </foreign-key>
    </foreign-keys>
  </table>

  <!-- ════════════════════════════════════════════════════════════════════════
       User Management — Org Membership
       ════════════════════════════════════════════════════════════════════════ -->

  <table name="org_members">
    <description>
      IAM-to-product bridge AND the product user record.
      Created ONLY when a user joins or creates an org — never at signup.
      No org_id column — org isolation is enforced by member_id range.
      member_id is the product identity (used for created_by, audit fields, RBAC).
    </description>
    <columns>
      <column name="member_id">
        <description>Org-scoped sequence PK. Product identity for this user in this org.</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
        <uniquevalue-generation>
          <generator-name>org_members.member_id</generator-name>
        </uniquevalue-generation>
      </column>
      <column name="auth_account_id">
        <description>FK to iam_auth_accounts.auth_account_id. The IAM identity bridge.</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="status">
        <description>Membership status: active | suspended</description>
        <data-type>VARCHAR</data-type>
        <max-size>20</max-size>
        <nullable>false</nullable>
      </column>
      <column name="joined_at">
        <description>When the member joined this org</description>
        <data-type>DATETIME</data-type>
        <nullable>false</nullable>
      </column>
    </columns>
    <primary-key name="org_members_PK">
      <primary-key-column>member_id</primary-key-column>
    </primary-key>
    <!--
      NOTE: FK is application-enforced only. iam_auth_accounts is a framework-layer table
      (not in this DD) — a DB-level FK would couple the product schema to the IAM schema.
      Per-org uniqueness of auth_account_id is enforced by the member import handler
      (a global UNIQUE constraint would wrongly block the same person joining multiple orgs).
    -->
    <foreign-keys>
      <foreign-key name="org_members_iam_auth_accounts_FK">
        <fk-column>auth_account_id</fk-column>
        <ref-table>iam_auth_accounts</ref-table>
        <ref-column>auth_account_id</ref-column>
      </foreign-key>
    </foreign-keys>
  </table>

  <!-- ════════════════════════════════════════════════════════════════════════
       Custom Modules — EAV Model
       ════════════════════════════════════════════════════════════════════════ -->

  <table name="custom_modules">
    <description>
      Custom module definitions created by org admins.
      module_handle is the URL-safe identifier for the module API.
      No org_id — scoped by module_id range.
    </description>
    <columns>
      <column name="module_id">
        <description>Org-scoped sequence PK</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
        <uniquevalue-generation>
          <generator-name>custom_modules.module_id</generator-name>
        </uniquevalue-generation>
      </column>
      <column name="name">
        <description>Human-readable module name e.g. IT Procurement</description>
        <data-type>VARCHAR</data-type>
        <max-size>255</max-size>
        <nullable>false</nullable>
      </column>
      <column name="module_handle">
        <description>URL-safe unique handle e.g. it_procurement</description>
        <data-type>VARCHAR</data-type>
        <max-size>100</max-size>
        <nullable>false</nullable>
      </column>
      <column name="description">
        <description>Optional module description</description>
        <data-type>VARCHAR</data-type>
        <max-size>1000</max-size>
        <nullable>true</nullable>
      </column>
      <column name="status">
        <description>active | inactive</description>
        <data-type>VARCHAR</data-type>
        <max-size>20</max-size>
        <nullable>false</nullable>
      </column>
      <column name="created_by">
        <description>member_id of the org member who created the module</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="created_at">
        <description>Creation timestamp</description>
        <data-type>DATETIME</data-type>
        <nullable>false</nullable>
      </column>
    </columns>
    <primary-key name="custom_modules_PK">
      <primary-key-column>module_id</primary-key-column>
    </primary-key>
    <!--
      NOTE: FK is application-enforced only — created_by is a range-scoped member_id.
      module_handle uniqueness within an org is also enforced by the handler
      (a global UNIQUE constraint would wrongly span all orgs).
    -->
    <foreign-keys>
      <foreign-key name="custom_modules_org_members_FK">
        <fk-column>created_by</fk-column>
        <ref-table>org_members</ref-table>
        <ref-column>member_id</ref-column>
      </foreign-key>
    </foreign-keys>
  </table>

  <table name="custom_module_fields">
    <description>
      Field schema definitions for each custom module.
      field_type: text | number | date | datetime | boolean | dropdown | multiselect | reference
      config_json stores dropdown options, reference module config, etc.
    </description>
    <columns>
      <column name="field_id">
        <description>Org-scoped sequence PK</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
        <uniquevalue-generation>
          <generator-name>custom_module_fields.field_id</generator-name>
        </uniquevalue-generation>
      </column>
      <column name="module_id">
        <description>FK to custom_modules.module_id</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="field_name">
        <description>Internal field name e.g. vendor_name</description>
        <data-type>VARCHAR</data-type>
        <max-size>100</max-size>
        <nullable>false</nullable>
      </column>
      <column name="field_label">
        <description>Display label e.g. Vendor Name</description>
        <data-type>VARCHAR</data-type>
        <max-size>255</max-size>
        <nullable>false</nullable>
      </column>
      <column name="field_type">
        <description>text | number | date | datetime | boolean | dropdown | multiselect | reference</description>
        <data-type>VARCHAR</data-type>
        <max-size>50</max-size>
        <nullable>false</nullable>
      </column>
      <column name="is_required">
        <description>1 = field is mandatory on record create/edit</description>
        <data-type>BOOLEAN</data-type>
        <max-size>1</max-size>
        <nullable>false</nullable>
      </column>
      <column name="is_unique">
        <description>1 = field value must be unique within the module</description>
        <data-type>BOOLEAN</data-type>
        <max-size>1</max-size>
        <nullable>false</nullable>
      </column>
      <column name="default_value">
        <description>Optional default value (stored as text)</description>
        <data-type>VARCHAR</data-type>
        <max-size>500</max-size>
        <nullable>true</nullable>
      </column>
      <column name="field_order">
        <description>Display ordering within the module form</description>
        <data-type>INT</data-type>
        <nullable>false</nullable>
      </column>
      <column name="config_json">
        <description>Dropdown options, reference config, validation rules (JSON blob)</description>
        <data-type>JSON</data-type>
        <nullable>true</nullable>
      </column>
      <column name="status">
        <description>active | inactive</description>
        <data-type>VARCHAR</data-type>
        <max-size>20</max-size>
        <nullable>false</nullable>
      </column>
      <column name="created_at">
        <description>Field definition creation timestamp</description>
        <data-type>DATETIME</data-type>
        <nullable>false</nullable>
      </column>
    </columns>
    <primary-key name="custom_module_fields_PK">
      <primary-key-column>field_id</primary-key-column>
    </primary-key>
    <!--
      NOTE: FK is application-enforced only — module_id is a range-scoped PK.
      For reference-type fields, config_json holds { ref_module_id }; that cross-module
      reference is also application-layer only (handler validates within org range).
    -->
    <foreign-keys>
      <foreign-key name="custom_module_fields_custom_modules_FK">
        <fk-column>module_id</fk-column>
        <ref-table>custom_modules</ref-table>
        <ref-column>module_id</ref-column>
      </foreign-key>
    </foreign-keys>
  </table>

  <table name="custom_module_records">
    <description>
      Actual records created inside a custom module (the entity rows).
      No field values here — those are in custom_module_values (EAV pattern).
      created_by and module_id are the only metadata columns on this record envelope.
    </description>
    <columns>
      <column name="record_id">
        <description>Org-scoped sequence PK</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
        <uniquevalue-generation>
          <generator-name>custom_module_records.record_id</generator-name>
        </uniquevalue-generation>
      </column>
      <column name="module_id">
        <description>FK to custom_modules.module_id</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="created_by">
        <description>member_id of the org member who created the record</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="created_at">
        <description>Record creation timestamp</description>
        <data-type>DATETIME</data-type>
        <nullable>false</nullable>
      </column>
      <column name="updated_at">
        <description>Last update timestamp</description>
        <data-type>DATETIME</data-type>
        <nullable>true</nullable>
      </column>
    </columns>
    <primary-key name="custom_module_records_PK">
      <primary-key-column>record_id</primary-key-column>
    </primary-key>
    <!--
      NOTE: Both FKs are application-enforced only — all PKs are range-scoped;
      no DB-level FK across range-isolated tables.
    -->
    <foreign-keys>
      <foreign-key name="custom_module_records_custom_modules_FK">
        <fk-column>module_id</fk-column>
        <ref-table>custom_modules</ref-table>
        <ref-column>module_id</ref-column>
      </foreign-key>
      <foreign-key name="custom_module_records_org_members_FK">
        <fk-column>created_by</fk-column>
        <ref-table>org_members</ref-table>
        <ref-column>member_id</ref-column>
      </foreign-key>
    </foreign-keys>
  </table>

  <table name="custom_module_values">
    <description>
      EAV field values for custom module records.
      value_text is the primary storage for ALL types (stored as string).
      value_number and value_date are populated additionally for typed fields
      to support range queries and sorting.
      Reference fields store the referenced record_id as text in value_text.
    </description>
    <columns>
      <column name="value_id">
        <description>Org-scoped sequence PK</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
        <uniquevalue-generation>
          <generator-name>custom_module_values.value_id</generator-name>
        </uniquevalue-generation>
      </column>
      <column name="record_id">
        <description>FK to custom_module_records.record_id</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="field_id">
        <description>FK to custom_module_fields.field_id</description>
        <data-type>BIGINT</data-type>
        <max-size>19</max-size>
        <nullable>false</nullable>
      </column>
      <column name="value_text">
        <description>Primary storage for all field types (text, boolean, dropdown, multiselect, reference)</description>
        <data-type>TEXT</data-type>
        <nullable>true</nullable>
      </column>
      <column name="value_number">
        <description>Populated for number/decimal fields — enables range queries</description>
        <data-type>DECIMAL</data-type>
        <max-size>20,4</max-size>
        <nullable>true</nullable>
      </column>
      <column name="value_date">
        <description>Populated for date/datetime fields — enables date range queries</description>
        <data-type>DATETIME</data-type>
        <nullable>true</nullable>
      </column>
    </columns>
    <primary-key name="custom_module_values_PK">
      <primary-key-column>value_id</primary-key-column>
    </primary-key>
    <!--
      NOTE: Both FKs are application-enforced only — all PKs are range-scoped.
      For reference-type fields, value_text stores a foreign record_id as a string;
      that cross-record reference is also application-layer only (architecture-knowledge-base.md §13 rule 19).
    -->
    <foreign-keys>
      <foreign-key name="custom_module_values_custom_module_records_FK">
        <fk-column>record_id</fk-column>
        <ref-table>custom_module_records</ref-table>
        <ref-column>record_id</ref-column>
      </foreign-key>
      <foreign-key name="custom_module_values_custom_module_fields_FK">
        <fk-column>field_id</fk-column>
        <ref-table>custom_module_fields</ref-table>
        <ref-column>field_id</ref-column>
      </foreign-key>
    </foreign-keys>
  </table>

</data-dictionary>
